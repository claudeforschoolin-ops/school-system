# قاعدة البيانات
DATABASE_URL="postgresql://manassa:manassa@localhost:5432/manassa_dev"
# قاعدة بيانات الاختبارات التكاملية (تُمسح في كل تشغيل)
TEST_DATABASE_URL="postgresql://manassa:manassa@localhost:5432/manassa_test"
# قاعدة ظل لأوامر prisma migrate dev/diff
SHADOW_DATABASE_URL="postgresql://manassa:manassa@localhost:5432/manassa_shadow"

# سر توقيع الرموز (غيّره في الإنتاج: openssl rand -base64 48)
AUTH_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"
# مفتاح تشفير الحقول الحساسة (32 بايت base64): openssl rand -base64 32
FIELD_ENCRYPTION_KEY="3q2+7w3q2+7w3q2+7w3q2+7w3q2+7w3q2+7w3q2+7w0="

# عنوان التطبيق (يُستخدم في روابط الدعوات واستعادة كلمة المرور)
APP_URL="http://localhost:3000"

# Redis (اختياري في المرحلة ١ — لتحديد المعدّل والحضور اللحظي متعدد النسخ)
REDIS_URL="redis://localhost:6379"

# تخزين الملفات: local أو s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# إظهار لافتة «بيانات تجريبية»
DEMO_MODE="true"

# سر استدعاء الأتمتة المجدولة: POST /api/cron/automations بترويسة Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
