// =====================================================================
// منصة — مخطط قاعدة البيانات (المرحلة ١: الأساس)
// ---------------------------------------------------------------------
// قواعد عامة:
//  - كل كيان (عدا Tenant) يحمل tenantId، وكل الاستعلامات تمر عبر عميل
//    مقيّد بالمستأجر (src/server/db/tenant.ts) يحقن tenantId إلزامياً.
//  - الحقول القياسية: createdAt, updatedAt, createdById, updatedById,
//    deletedAt (حذف ناعم لغير المالية).
//  - سجل التدقيق AuditLog للإلحاق فقط، ومحمي بـ Trigger يمنع التعديل والحذف.
// =====================================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------
// المستأجر والهيكل التنظيمي
// ---------------------------------------------------------------------

model Tenant {
  id           String   @id @default(cuid())
  slug         String   @unique
  /// اسم المدرسة أو مجموعة المدارس
  name         String
  /// اسم المنصة الظاهر في الشريط الجانبي وتسجيل الدخول والفواتير
  platformName String   @default("منصة")
  logoUrl      String?
  /// لون تمييز ضمن الألوان الرسمية المعتمدة فقط (navy | teal | slate)
  accentColor  String   @default("navy")
  currency     String   @default("SAR")
  locale       String   @default("ar")
  timezone     String   @default("Asia/Riyadh")
  /// إعدادات عامة: سياسة كلمات المرور، الترقيم، الإشعارات...
  settings     Json     @default("{}")
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branches      Branch[]
  stages        Stage[]
  users         User[]
  roles         Role[]
  academicYears AcademicYear[]
  teamspaces    Teamspace[]
}

enum BranchGender {
  BOYS
  GIRLS
  MIXED
}

model Branch {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  gender      BranchGender @default(MIXED)
  address     String?
  phone       String?
  email       String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  students   Student[]
  admissions Admission[]
  sections   Section[]
  userRoles  UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// المرحلة الدراسية: رياض أطفال، ابتدائي، متوسط، ثانوي
model Stage {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  grades    Grade[]
  userRoles UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// الصف الدراسي داخل مرحلة
model Grade {
  id          String    @id @default(cuid())
  tenantId    String
  stageId     String
  stage       Stage     @relation(fields: [stageId], references: [id])
  code        String
  name        String
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  students      Student[]
  admissions    Admission[]
  gradeSubjects GradeSubject[]
  sections      Section[]

  @@unique([tenantId, code])
  @@index([tenantId, stageId])
}

/// الفصل/الشعبة داخل صف وفرع وعام دراسي
model Section {
  id             String       @id @default(cuid())
  tenantId       String
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])
  gradeId        String
  grade          Grade        @relation(fields: [gradeId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  name           String
  capacity       Int          @default(30)
  homeroomUserId String?
  room           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?

  students    Student[]
  assignments TeacherAssignment[]

  @@unique([tenantId, branchId, gradeId, academicYearId, name])
  @@index([tenantId, branchId])
}

model AcademicYear {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  name        String
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  isCurrent   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  students   Student[]
  admissions Admission[]
  terms      Term[]
  sections   Section[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Term {
  id             String       @id @default(cuid())
  tenantId       String
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  name           String
  order          Int          @default(1)
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?

  @@index([tenantId, academicYearId])
}

// ---------------------------------------------------------------------
// المستخدمون والمصادقة
// ---------------------------------------------------------------------

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model User {
  id                String     @id @default(cuid())
  tenantId          String
  tenant            Tenant     @relation(fields: [tenantId], references: [id])
  email             String
  phone             String?
  name              String
  jobTitle          String?
  avatarUrl         String?
  /// لون الصورة الرمزية (من ألوان اللوحة الرسمية)
  avatarColor       String     @default("navy")
  passwordHash      String?
  status            UserStatus @default(ACTIVE)
  /// المصادقة الثنائية (TOTP) — السر مشفّر بـ AES-256-GCM
  twoFactorEnabled  Boolean    @default(false)
  twoFactorSecret   String?
  /// رموز الاسترداد (مُجزّأة)
  twoFactorBackup   Json?
  failedLoginCount  Int        @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  /// تفضيلات: المظهر، اللغة، الأرقام، التقويم، عرض الشريط الجانبي...
  preferences       Json       @default("{}")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  createdById       String?
  updatedById       String?
  deletedAt         DateTime?

  roles         UserRole[]
  sessions      Session[]
  notifications Notification[] @relation("NotificationRecipient")

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([email])
}

enum PermissionScope {
  /// كل المدرسة / المجموعة
  ALL
  /// الفروع المسندة للمستخدم
  BRANCH
  /// المراحل المسندة للمستخدم
  STAGE
  /// السجلات المسندة إليه (فصوله، مواده، أبناؤه)
  ASSIGNED
  /// سجلاته فقط
  OWN
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  /// مفتاح ثابت للأدوار النظامية (OWNER, PRINCIPAL...) أو معرّف مخصص
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  /// المصادقة الثنائية إلزامية لهذا الدور
  requires2fa Boolean  @default(false)
  color       String   @default("slate")
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

/// صلاحية دور على (وحدة × إجراء) ضمن نطاق بيانات
model RolePermission {
  id       String          @id @default(cuid())
  tenantId String
  roleId   String
  role     Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module   String
  action   String
  scope    PermissionScope @default(ALL)

  @@unique([roleId, module, action])
  @@index([tenantId, roleId])
}

model UserRole {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// تقييد الدور بفرع (لنطاق BRANCH)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  /// تقييد الدور بمرحلة (لنطاق STAGE)
  stageId   String?
  stage     Stage?   @relation(fields: [stageId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, roleId, branchId, stageId])
  @@index([tenantId, userId])
}

model Session {
  id                String    @id @default(cuid())
  tenantId          String
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 للرمز — الرمز الخام لا يُخزَّن أبداً
  tokenHash         String    @unique
  ip                String?
  userAgent         String?
  deviceLabel       String?
  twoFactorVerified Boolean   @default(false)
  createdAt         DateTime  @default(now())
  lastActiveAt      DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?

  @@index([tenantId, userId])
}

enum AuthTokenType {
  PASSWORD_RESET
  INVITE
  LOGIN_OTP
  TWO_FACTOR_CHALLENGE
}

model AuthToken {
  id        String        @id @default(cuid())
  tenantId  String
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  /// للرموز الرقمية (OTP): الرمز المجزّأ وعدد المحاولات
  codeHash  String?
  attempts  Int           @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([tenantId, userId, type])
}

/// صندوق البريد الصادر (للتطوير: يُعرض بدلاً من الإرسال الفعلي)
model OutboundMessage {
  id        String   @id @default(cuid())
  tenantId  String
  channel   String
  to        String
  subject   String?
  body      String
  status    String   @default("QUEUED")
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ---------------------------------------------------------------------
// سجل التدقيق — للإلحاق فقط (Trigger يمنع UPDATE/DELETE/TRUNCATE)
// ---------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  userName   String?
  /// CREATE | UPDATE | DELETE | RESTORE | LOGIN | LOGIN_FAILED | LOGOUT | EXPORT | PERMISSION_CHANGE ...
  action     String
  entityType String
  entityId   String?
  summary    String?
  oldValue   Json?
  newValue   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, userId])
}

// ---------------------------------------------------------------------
// الإشعارات والموافقات
// ---------------------------------------------------------------------

enum NotificationType {
  MENTION
  COMMENT
  ASSIGNMENT
  APPROVAL
  AUTOMATION
  SYSTEM
  MESSAGE
}

model Notification {
  id         String           @id @default(cuid())
  tenantId   String
  userId     String
  user       User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String?
  link       String?
  actorId    String?
  entityType String?
  entityId   String?
  readAt     DateTime?
  archivedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([tenantId, userId, readAt])
  @@index([tenantId, userId, createdAt])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ApprovalRequest {
  id            String         @id @default(cuid())
  tenantId      String
  /// نوع الطلب (مفتاح مسار الموافقة): discount_exception, expense, leave...
  type          String
  title         String
  description   String?
  entityType    String?
  entityId      String?
  link          String?
  payload       Json           @default("{}")
  requestedById String
  status        ApprovalStatus @default(PENDING)
  currentStep   Int            @default(1)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  decidedAt     DateTime?

  steps ApprovalStep[]

  @@index([tenantId, status])
}

model ApprovalStep {
  id             String          @id @default(cuid())
  tenantId       String
  requestId      String
  request        ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  order          Int
  name           String
  /// المعتمد: دور أو مستخدم محدد
  approverRoleId String?
  approverUserId String?
  status         ApprovalStatus  @default(PENDING)
  decidedById    String?
  decidedAt      DateTime?
  comment        String?
  /// مهلة التصعيد بالساعات (اختياري)
  dueHours       Int?

  @@unique([requestId, order])
  @@index([tenantId, status])
}

// ---------------------------------------------------------------------
// مساحات الفرق والصفحات وقواعد البيانات (روح Notion)
// ---------------------------------------------------------------------

model Teamspace {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  key         String
  name        String
  icon        String?
  description String?
  /// الوحدات التي تمنح صلاحية الاطلاع على المساحة (أي منها يكفي)
  moduleKeys  String[]  @default([])
  position    Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  members TeamspaceMember[]
  pages   Page[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

enum AccessLevel {
  VIEW
  COMMENT
  EDIT
  FULL
}

model TeamspaceMember {
  id          String      @id @default(cuid())
  tenantId    String
  teamspaceId String
  teamspace   Teamspace   @relation(fields: [teamspaceId], references: [id], onDelete: Cascade)
  userId      String
  level       AccessLevel @default(EDIT)
  createdAt   DateTime    @default(now())

  @@unique([teamspaceId, userId])
  @@index([tenantId, userId])
}

enum PageKind {
  PAGE
  DATABASE
}

model Page {
  id          String     @id @default(cuid())
  tenantId    String
  kind        PageKind   @default(PAGE)
  /// صفحة ضمن مساحة فريق، أو صفحة خاصة (teamspaceId = null و ownerId محدد)
  teamspaceId String?
  teamspace   Teamspace? @relation(fields: [teamspaceId], references: [id])
  ownerId     String?
  parentId    String?
  parent      Page?      @relation("PageTree", fields: [parentId], references: [id])
  children    Page[]     @relation("PageTree")
  title       String     @default("")
  /// أيقونة: "lucide:<name>" أو رمز تعبيري أو "img:<url>"
  icon        String?
  /// الغلاف: "color:<token>" أو رابط صورة
  cover       String?
  description String?
  /// محتوى المحرر (Tiptap JSON)
  content     Json?
  fullWidth   Boolean    @default(false)
  isLocked    Boolean    @default(false)
  /// مفتاح نظامي للصفحات المولّدة (لوحات، قوالب)
  systemKey   String?
  position    Float      @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdById String?
  updatedById String?
  /// سلة المهملات (حذف ناعم)
  deletedAt   DateTime?

  database Database?
  shares   PageShare[]

  @@index([tenantId, teamspaceId, parentId])
  @@index([tenantId, ownerId])
}

/// مشاركة صفحة (خاصة غالباً) مع مستخدمين محددين
model PageShare {
  id        String      @id @default(cuid())
  tenantId  String
  pageId    String
  page      Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId    String
  level     AccessLevel @default(VIEW)
  createdAt DateTime    @default(now())

  @@unique([pageId, userId])
  @@index([tenantId, userId])
}

model Database {
  id          String   @id @default(cuid())
  tenantId    String
  /// الصفحة المضيفة لقاعدة البيانات (عرض كامل)
  pageId      String   @unique
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// اسم خاصية العنوان
  titleLabel  String   @default("الاسم")
  /// عدّاد الترقيم التلقائي للسجلات
  rowCounter  Int      @default(0)
  rowPrefix   String?
  /// مصدر نظامي: السجلات من جداول مخصصة (admissions, students…) بدل DatabaseRow
  source      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  properties  DatabaseProperty[]
  views       DatabaseView[]
  rows        DatabaseRow[]
  templates   DatabaseTemplate[]
  automations Automation[]

  @@unique([tenantId, source])
  @@index([tenantId])
}

enum PropertyType {
  TEXT
  NUMBER
  MONEY
  DATE
  SELECT
  MULTI_SELECT
  STATUS
  PERSON
  FILES
  CHECKBOX
  URL
  PHONE
  EMAIL
  RELATION
  ROLLUP
  FORMULA
  CREATED_TIME
  UPDATED_TIME
  CREATED_BY
}

model DatabaseProperty {
  id          String       @id @default(cuid())
  tenantId    String
  databaseId  String
  database    Database     @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  name        String
  type        PropertyType
  /// إعدادات الخاصية: خيارات الاختيار، تنسيق الرقم، هدف العلاقة، معادلة...
  config      Json         @default("{}")
  /// مفتاح الحقل في المصدر النظامي (لا يُحذف ولا يتغير نوعه)
  systemKey   String?
  description String?
  position    Float        @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String?
  updatedById String?

  @@unique([databaseId, systemKey])
  @@index([tenantId, databaseId])
}

enum ViewType {
  TABLE
  BOARD
  CALENDAR
  TIMELINE
  GALLERY
  LIST
}

model DatabaseView {
  id          String   @id @default(cuid())
  tenantId    String
  databaseId  String
  database    Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  name        String
  type        ViewType
  icon        String?
  /// التصفية، الفرز، الأعمدة المرئية، التجميع، ارتفاع الصفوف...
  config      Json     @default("{}")
  /// عرض شخصي لا يراه إلا مالكه
  isPersonal  Boolean  @default(false)
  ownerId     String?
  position    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([tenantId, databaseId])
}

model DatabaseRow {
  id          String    @id @default(cuid())
  tenantId    String
  databaseId  String
  database    Database  @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  /// رقم تسلسلي داخل قاعدة البيانات
  number      Int
  title       String    @default("")
  icon        String?
  cover       String?
  /// قيم الخصائص: { [propertyId]: value }
  values      Json      @default("{}")
  /// محتوى صفحة السجل (Tiptap JSON)
  content     Json?
  position    Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@unique([databaseId, number])
  @@index([tenantId, databaseId, deletedAt])
  /// فهرس GIN لتسريع البحث داخل القيم (مثل «المهام المسندة إليّ»)
  @@index([values(ops: JsonbPathOps)], type: Gin)
}

model DatabaseTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  databaseId  String
  database    Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  name        String
  icon        String?
  title       String   @default("")
  values      Json     @default("{}")
  content     Json?
  isDefault   Boolean  @default(false)
  position    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([tenantId, databaseId])
}

/// قاعدة أتمتة: «عندما … فإن …»
model Automation {
  id          String    @id @default(cuid())
  tenantId    String
  databaseId  String
  database    Database  @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  name        String
  isEnabled   Boolean   @default(true)
  /// { type: "ROW_CREATED" | "PROPERTY_CHANGED" | "DATE_REACHED", ... }
  trigger     Json
  /// [{ type: "SET_PROPERTY" | "NOTIFY" | "ADD_COMMENT", ... }]
  actions     Json
  runCount    Int       @default(0)
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?

  runs AutomationRun[]

  @@index([tenantId, databaseId])
}

model AutomationRun {
  id           String     @id @default(cuid())
  tenantId     String
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  rowId        String?
  status       String
  message      String?
  createdAt    DateTime   @default(now())

  @@index([tenantId, automationId, createdAt])
}

/// نسخ الصفحات النصية للاسترجاع
model PageVersion {
  id          String   @id @default(cuid())
  tenantId    String
  /// "PAGE" | "ROW"
  targetType  String
  targetId    String
  title       String
  content     Json?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([tenantId, targetType, targetId, createdAt])
}

// ---------------------------------------------------------------------
// التعليقات والإشارات والمفضلة
// ---------------------------------------------------------------------

model Comment {
  id           String    @id @default(cuid())
  tenantId     String
  /// "PAGE" | "ROW"
  targetType   String
  targetId     String
  /// تعليق على خاصية محددة (اختياري)
  propertyId   String?
  parentId     String?
  parent       Comment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies      Comment[] @relation("CommentThread")
  authorId     String
  body         String
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([tenantId, targetType, targetId])
}

model Mention {
  id              String   @id @default(cuid())
  tenantId        String
  mentionedUserId String
  mentionedById   String
  /// "COMMENT" | "PAGE" | "ROW" | "MESSAGE"
  sourceType      String
  sourceId        String
  targetType      String
  targetId        String
  createdAt       DateTime @default(now())

  @@index([tenantId, mentionedUserId])
}

model Favorite {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  /// "PAGE" | "ROW"
  targetType String
  targetId   String
  position   Float    @default(0)
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([tenantId, userId])
}

model RecentVisit {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  targetType String
  targetId   String
  visitedAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([tenantId, userId, visitedAt])
}

// ---------------------------------------------------------------------
// التقويم والمحادثات والملفات والترقيم
// ---------------------------------------------------------------------

enum EventCategory {
  ACADEMIC
  ADMINISTRATIVE
  EXAM
  MEETING
  HOLIDAY
  ACTIVITY
}

model CalendarEvent {
  id          String        @id @default(cuid())
  tenantId    String
  branchId    String?
  title       String
  description String?
  category    EventCategory @default(ADMINISTRATIVE)
  location    String?
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@index([tenantId, startAt])
}

enum ConversationKind {
  DIRECT
  GROUP
  AGENT
}

model Conversation {
  id            String           @id @default(cuid())
  tenantId      String
  kind          ConversationKind @default(DIRECT)
  title         String?
  /// مفتاح المساعد الذكي لمحادثات المساعدين
  agentKey      String?
  createdById   String
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  members  ConversationMember[]
  messages Message[]

  @@index([tenantId, lastMessageAt])
}

model ConversationMember {
  id             String       @id @default(cuid())
  tenantId       String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([tenantId, userId])
}

model Message {
  id             String       @id @default(cuid())
  tenantId       String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// null لرسائل النظام أو المساعد
  authorId       String?
  body           String
  createdAt      DateTime     @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?

  @@index([tenantId, conversationId, createdAt])
}

model FileObject {
  id           String   @id @default(cuid())
  tenantId     String
  storageKey   String   @unique
  name         String
  mime         String
  size         Int
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([tenantId])
}

/// ترقيم تسلسلي غير منقطع (فواتير، سندات، أرقام أكاديمية...)
model Sequence {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  prefix    String   @default("")
  padding   Int      @default(5)
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
}

// =====================================================================
// المرحلة ٢: الطلاب والقبول والشؤون الأكاديمية
// الأرقام الوطنية تُخزَّن مشفّرة (Enc) مع بصمة HMAC للبحث ومنع التكرار (Hash) وآخر ٤ أرقام للعرض.
// =====================================================================

enum Gender {
  MALE
  FEMALE
}

enum IdType {
  NATIONAL_ID
  IQAMA
  PASSPORT
}

enum StudentStatus {
  /// منتظم
  ACTIVE
  /// منقطع
  INACTIVE
  /// منقول
  TRANSFERRED
  /// متخرج
  GRADUATED
  /// منسحب
  WITHDRAWN
  /// مؤجل
  DEFERRED
}

enum GuardianRelation {
  FATHER
  MOTHER
  /// وصي
  GUARDIAN
  OTHER
}

model Guardian {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  idType          IdType    @default(NATIONAL_ID)
  nationalIdHash  String?
  nationalIdEnc   String?
  nationalIdLast4 String?
  phone           String
  phoneAlt        String?
  email           String?
  occupation      String?
  employer        String?
  address         String?
  /// حساب مستخدم مرتبط (اختياري)
  userId          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?
  updatedById     String?
  deletedAt       DateTime?

  students StudentGuardian[]
  invoices Invoice[]

  @@unique([tenantId, nationalIdHash])
  @@index([tenantId, phone])
}

model Student {
  id                String        @id @default(cuid())
  tenantId          String
  branchId          String
  branch            Branch        @relation(fields: [branchId], references: [id])
  /// الرقم الأكاديمي (تسلسل بصيغة قابلة للضبط)
  academicNumber    String
  /// حساب الطالب (اختياري) لنطاق «سجلاته فقط»
  userId            String?
  firstName         String
  fatherName        String
  grandfatherName   String
  familyName        String
  /// الاسم الرباعي (مشتق للبحث والعرض)
  fullName          String
  gender            Gender
  nationality       String        @default("SA")
  idType            IdType        @default(NATIONAL_ID)
  nationalIdHash    String?
  nationalIdEnc     String?
  nationalIdLast4   String?
  birthDate         DateTime      @db.Date
  birthPlace        String?
  photoUrl          String?
  cover             String?
  status            StudentStatus @default(ACTIVE)
  academicYearId    String
  academicYear      AcademicYear  @relation(fields: [academicYearId], references: [id])
  gradeId           String
  grade             Grade         @relation(fields: [gradeId], references: [id])
  sectionId         String?
  section           Section?      @relation(fields: [sectionId], references: [id])
  enrollmentDate    DateTime      @db.Date
  previousSchool    String?
  // الصحة
  bloodType         String?
  chronicConditions String?
  allergies         String?
  medications       String?
  /// حالة صحية حرجة: شارة حمراء للمعلمين والعيادة
  criticalHealth    Boolean       @default(false)
  healthNotes       String?
  // الوصول والخدمات
  transportMode     String?
  busNumber         String?
  mealPlan          String?
  /// جهات اتصال الطوارئ [{name, relation, phone}]
  emergencyContacts Json          @default("[]")
  /// ملاحظات حرة (Tiptap)
  notes             Json?
  /// قيم الخصائص التي يضيفها المستخدم في عروض قاعدة البيانات
  customValues      Json          @default("{}")
  position          Float         @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  createdById       String?
  updatedById       String?
  deletedAt         DateTime?

  guardians     StudentGuardian[]
  documents     StudentDocument[]
  attendance    Attendance[]
  admission     Admission?
  leaves        StudentLeave[]
  transfers     Transfer[]
  behavior      BehaviorRecord[]
  cases         CounselingCase[]
  registrations ActivityRegistration[]
  invoices      Invoice[]
  discounts     StudentDiscount[]

  @@unique([tenantId, academicNumber])
  @@unique([tenantId, nationalIdHash])
  @@index([tenantId, branchId, status])
  @@index([tenantId, gradeId, sectionId])
  @@index([tenantId, fullName])
}

model StudentGuardian {
  id                    String           @id @default(cuid())
  tenantId              String
  studentId             String
  student               Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId            String
  guardian              Guardian         @relation(fields: [guardianId], references: [id])
  relation              GuardianRelation
  isPrimary             Boolean          @default(false)
  canPickup             Boolean          @default(true)
  receivesNotifications Boolean          @default(true)
  createdAt             DateTime         @default(now())

  @@unique([studentId, guardianId])
  @@index([tenantId, guardianId])
}

model StudentDocument {
  id           String    @id @default(cuid())
  tenantId     String
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// BIRTH_CERTIFICATE | ID_COPY | LAST_REPORT | MEDICAL | PHOTO | VACCINATION | OTHER
  type         String
  name         String
  fileId       String
  url          String
  size         Int       @default(0)
  mime         String?
  expiresAt    DateTime? @db.Date
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  createdById  String?
  deletedAt    DateTime?

  @@index([tenantId, studentId])
}

enum AdmissionStage {
  /// طلب جديد
  NEW
  /// قيد المراجعة
  REVIEW
  /// اختبار/مقابلة
  ASSESSMENT
  /// مقبول
  ACCEPTED
  /// مرفوض
  REJECTED
  /// قائمة انتظار
  WAITLIST
  /// مسجّل
  ENROLLED
}

model Admission {
  id               String            @id @default(cuid())
  tenantId         String
  branchId         String
  branch           Branch            @relation(fields: [branchId], references: [id])
  /// رقم الطلب
  number           Int
  academicYearId   String
  academicYear     AcademicYear      @relation(fields: [academicYearId], references: [id])
  stage            AdmissionStage    @default(NEW)
  firstName        String
  fatherName       String            @default("")
  grandfatherName  String            @default("")
  familyName       String            @default("")
  fullName         String
  gender           Gender?
  nationality      String            @default("SA")
  idType           IdType            @default(NATIONAL_ID)
  nationalIdHash   String?
  nationalIdEnc    String?
  nationalIdLast4  String?
  birthDate        DateTime?         @db.Date
  requestedGradeId String?
  requestedGrade   Grade?            @relation(fields: [requestedGradeId], references: [id])
  previousSchool   String?
  /// ولي الأمر الأساسي
  guardianName     String?
  guardianRelation GuardianRelation?
  guardianPhone    String?
  guardianEmail    String?
  /// بقية بيانات الأب والأم والوصي من النموذج [{relation, name, phone, email, occupation, nationalIdLast4, nationalIdEnc}]
  contacts         Json              @default("[]")
  address          String?
  /// المرفقات (FileValue[])
  attachments      Json              @default("[]")
  /// كيف عرفتنا
  source           String?
  /// المسؤول عن المتابعة
  ownerId          String?
  assessmentAt     DateTime?
  assessmentScore  Int?
  assessmentNotes  String?
  decisionAt       DateTime?
  decisionReason   String?
  /// PUBLIC_FORM | STAFF
  submittedVia     String            @default("STAFF")
  studentId        String?           @unique
  student          Student?          @relation(fields: [studentId], references: [id])
  notes            Json?
  customValues     Json              @default("{}")
  position         Float             @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdById      String?
  updatedById      String?
  deletedAt        DateTime?

  @@unique([tenantId, number])
  @@index([tenantId, stage])
  @@index([tenantId, nationalIdHash])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  /// مستأذن (خروج مبكر بإذن)
  PERMISSION
  /// غائب بعذر
  EXCUSED
}

model Attendance {
  id           String           @id @default(cuid())
  tenantId     String
  branchId     String
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sectionId    String
  date         DateTime         @db.Date
  /// 0 = تحضير يومي، وإلا رقم الحصة
  period       Int              @default(0)
  status       AttendanceStatus
  reason       String?
  minutesLate  Int?
  /// MANUAL | LEAVE | IMPORT
  source       String           @default("MANUAL")
  leaveId      String?
  recordedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  updatedById  String?

  @@unique([studentId, date, period])
  @@index([tenantId, sectionId, date])
  @@index([tenantId, date, status])
}

/// إجازة أو استئذان طالب
model StudentLeave {
  id           String         @id @default(cuid())
  tenantId     String
  branchId     String
  number       Int
  studentId    String
  student      Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// LEAVE (إجازة) | EARLY_DISMISSAL (استئذان)
  kind         String         @default("LEAVE")
  startDate    DateTime       @db.Date
  endDate      DateTime       @db.Date
  reason       String
  requestedBy  String?
  attachments  Json           @default("[]")
  status       ApprovalStatus @default(PENDING)
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  customValues Json           @default("{}")
  position     Float          @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  createdById  String?
  updatedById  String?
  deletedAt    DateTime?

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

enum TransferType {
  /// نقل بين الفصول
  SECTION
  /// نقل إلى صف/مرحلة أخرى
  GRADE
  /// قادم من مدرسة أخرى
  INCOMING
  /// إلى مدرسة أخرى
  OUTGOING
  /// انسحاب
  WITHDRAWAL
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

model Transfer {
  id                  String         @id @default(cuid())
  tenantId            String
  branchId            String
  number              Int
  studentId           String
  student             Student        @relation(fields: [studentId], references: [id])
  type                TransferType
  fromSectionId       String?
  toSectionId         String?
  toGradeId           String?
  otherSchool         String?
  reason              String
  effectiveDate       DateTime       @db.Date
  status              TransferStatus @default(PENDING)
  approvalRequestId   String?
  /// خلو الطرف المالي
  financialClearance  Boolean        @default(false)
  clearedById         String?
  clearedAt           DateTime?
  certificateNumber   String?
  certificateIssuedAt DateTime?
  attachments         Json           @default("[]")
  notes               Json?
  customValues        Json           @default("{}")
  position            Float          @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  createdById         String?
  updatedById         String?
  deletedAt           DateTime?

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

enum BehaviorKind {
  POSITIVE
  NEGATIVE
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model BehaviorRecord {
  id               String       @id @default(cuid())
  tenantId         String
  branchId         String
  number           Int
  studentId        String
  student          Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kind             BehaviorKind
  category         String
  points           Int          @default(0)
  severity         Severity     @default(LOW)
  occurredAt       DateTime
  description      String?
  actionTaken      String?
  guardianNotified Boolean      @default(false)
  reportedById     String?
  /// MANUAL | ATTENDANCE_THRESHOLD
  source           String       @default("MANUAL")
  customValues     Json         @default("{}")
  position         Float        @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  createdById      String?
  updatedById      String?
  deletedAt        DateTime?

  @@unique([tenantId, number])
  @@index([tenantId, studentId])
  @@index([tenantId, occurredAt])
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  MONITORING
  CLOSED
}

/// حالة إرشادية سرّية: يراها المرشد المسؤول والإدارة فقط
model CounselingCase {
  id                 String     @id @default(cuid())
  tenantId           String
  branchId           String
  number             Int
  studentId          String
  student            Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title              String
  category           String
  severity           Severity   @default(LOW)
  status             CaseStatus @default(OPEN)
  counselorId        String
  /// خطة العلاج الفردية (Tiptap)
  plan               Json?
  guardianSummonedAt DateTime?
  openedAt           DateTime   @default(now())
  closedAt           DateTime?
  customValues       Json       @default("{}")
  position           Float      @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  createdById        String?
  updatedById        String?
  deletedAt          DateTime?

  sessions CounselingSession[]

  @@unique([tenantId, number])
  @@index([tenantId, counselorId])
  @@index([tenantId, studentId])
}

model CounselingSession {
  id              String         @id @default(cuid())
  tenantId        String
  caseId          String
  case            CounselingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime
  durationMinutes Int            @default(30)
  /// SCHEDULED | DONE | MISSED | CANCELLED
  status          String         @default("SCHEDULED")
  attendees       String?
  summary         String?
  calendarEventId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdById     String?
  updatedById     String?

  @@index([tenantId, caseId])
}

// ---------------------------------------------------------------------
// الشؤون الأكاديمية
// ---------------------------------------------------------------------

model Room {
  id          String    @id @default(cuid())
  tenantId    String
  branchId    String
  code        String
  name        String
  /// CLASSROOM | LAB | COMPUTER | GYM | LIBRARY | HALL | ART
  kind        String    @default("CLASSROOM")
  capacity    Int       @default(30)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  @@unique([tenantId, branchId, code])
}

model Subject {
  id          String    @id @default(cuid())
  tenantId    String
  code        String
  name        String
  color       String    @default("navy")
  /// نوع القاعة المطلوب (اختياري): LAB, COMPUTER, GYM...
  roomKind    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  gradeSubjects GradeSubject[]

  @@unique([tenantId, code])
}

/// الخطة الدراسية: مادة في صف بعدد حصص أسبوعية
model GradeSubject {
  id            String   @id @default(cuid())
  tenantId      String
  gradeId       String
  grade         Grade    @relation(fields: [gradeId], references: [id])
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id])
  weeklyPeriods Int      @default(4)
  textbook      String?
  /// مادة «ثقيلة»: تُفضَّل في الحصص الأولى ولا تتكرر في اليوم نفسه
  heavy         Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?
  updatedById   String?

  units CurriculumUnit[]

  @@unique([gradeId, subjectId])
  @@index([tenantId])
}

model CurriculumUnit {
  id             String       @id @default(cuid())
  tenantId       String
  gradeSubjectId String
  gradeSubject   GradeSubject @relation(fields: [gradeSubjectId], references: [id], onDelete: Cascade)
  title          String
  order          Int          @default(0)
  objectives     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lessons CurriculumLesson[]

  @@index([tenantId, gradeSubjectId])
}

model CurriculumLesson {
  id         String         @id @default(cuid())
  tenantId   String
  unitId     String
  unit       CurriculumUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title      String
  order      Int            @default(0)
  /// أسبوع التنفيذ المخطط (١..)
  week       Int?
  periods    Int            @default(1)
  objectives String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  progress LessonProgress[]

  @@index([tenantId, unitId])
}

model LessonProgress {
  id            String           @id @default(cuid())
  tenantId      String
  lessonId      String
  lesson        CurriculumLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sectionId     String
  completedAt   DateTime         @default(now())
  completedById String?
  note          String?

  @@unique([lessonId, sectionId])
  @@index([tenantId, sectionId])
}

/// نصاب المعلم وتفضيلاته لعام دراسي
model TeacherLoad {
  id             String   @id @default(cuid())
  tenantId       String
  userId         String
  academicYearId String
  /// النصاب الأسبوعي
  quota          Int      @default(24)
  /// يوم الراحة المفضل (0=الأحد … 4=الخميس) أو null
  freeDay        Int?
  /// المواد المؤهل لتدريسها
  subjectIds     String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?
  updatedById    String?

  @@unique([userId, academicYearId])
  @@index([tenantId, academicYearId])
}

model TeacherAssignment {
  id             String   @id @default(cuid())
  tenantId       String
  academicYearId String
  sectionId      String
  section        Section  @relation(fields: [sectionId], references: [id])
  subjectId      String
  teacherId      String
  weeklyPeriods  Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?
  updatedById    String?

  @@unique([academicYearId, sectionId, subjectId])
  @@index([tenantId, teacherId])
}

/// جدول الجرس: أيام الدراسة وتوقيت الحصص لكل فرع
model BellSchedule {
  id             String   @id @default(cuid())
  tenantId       String
  branchId       String
  name           String
  /// أيام الدراسة (0=الأحد … 6=السبت)
  days           Int[]
  /// [{index, start: "07:00", end: "07:45"}] — الحصص فقط؛ الفسح بين الأوقات
  periods        Json
  /// أقصى عدد حصص متتالية للمعلم
  maxConsecutive Int      @default(3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedById    String?

  @@unique([tenantId, branchId])
}

model TimetableSlot {
  id             String   @id @default(cuid())
  tenantId       String
  academicYearId String
  sectionId      String
  day            Int
  period         Int
  subjectId      String
  teacherId      String
  roomId         String?
  /// مثبّتة يدوياً: لا يغيّرها المولّد
  locked         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?
  updatedById    String?

  @@unique([academicYearId, sectionId, day, period])
  @@unique([academicYearId, teacherId, day, period])
  @@unique([academicYearId, roomId, day, period])
  @@index([tenantId, academicYearId])
}

model Substitution {
  id                  String   @id @default(cuid())
  tenantId            String
  slotId              String
  date                DateTime @db.Date
  absentTeacherId     String
  substituteTeacherId String?
  /// PENDING | ASSIGNED | CANCELLED
  status              String   @default("PENDING")
  note                String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdById         String?
  updatedById         String?

  @@unique([slotId, date])
  @@index([tenantId, date])
}

enum ActivityKind {
  CLUB
  COMMITTEE
  TRIP
  COMPETITION
  EVENT
}

enum ActivityStatus {
  PLANNED
  REGISTRATION
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Activity {
  id              String         @id @default(cuid())
  tenantId        String
  branchId        String?
  number          Int
  title           String
  kind            ActivityKind   @default(CLUB)
  status          ActivityStatus @default(PLANNED)
  description     String?
  startAt         DateTime?
  endAt           DateTime?
  location        String?
  supervisorId    String?
  capacity        Int?
  /// رسم النشاط بأصغر وحدة (يُفوتر في المرحلة ٣)
  feeMinor        Int?
  requiresConsent Boolean        @default(false)
  gradeIds        String[]
  calendarEventId String?
  cover           String?
  /// ألبوم الصور (FileValue[])
  album           Json           @default("[]")
  notes           Json?
  customValues    Json           @default("{}")
  position        Float          @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdById     String?
  updatedById     String?
  deletedAt       DateTime?

  registrations ActivityRegistration[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model ActivityRegistration {
  id            String    @id @default(cuid())
  tenantId      String
  activityId    String
  activity      Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// REGISTERED | WAITLIST | CANCELLED | ATTENDED
  status        String    @default("REGISTERED")
  /// NOT_REQUIRED | PENDING | GRANTED | DENIED
  consentStatus String    @default("NOT_REQUIRED")
  consentBy     String?
  consentAt     DateTime?
  /// فاتورة رسم النشاط
  invoiceId     String?
  createdAt     DateTime  @default(now())
  createdById   String?
  updatedAt     DateTime  @updatedAt

  @@unique([activityId, studentId])
  @@index([tenantId, studentId])
}

// =====================================================================
// المرحلة ٣: النظام المحاسبي — كل المبالغ أعداد صحيحة بأصغر وحدة (هللة).
// سطور القيود BigInt (أرصدة الأصول الكبيرة)، والمستندات Int (مبلغ المستند الواحد).
// =====================================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum BalanceSide {
  DEBIT
  CREDIT
}

/// دليل الحسابات (شجري)
model Account {
  id            String      @id @default(cuid())
  tenantId      String
  code          String
  name          String
  type          AccountType
  normalSide    BalanceSide
  parentId      String?
  parent        Account?    @relation("AccountTree", fields: [parentId], references: [id])
  children      Account[]   @relation("AccountTree")
  /// حساب تجميعي (عنوان) لا يُرحَّل عليه مباشرة
  isGroup       Boolean     @default(false)
  /// مفتاح نظامي لخريطة القيود الآلية (CASH، AR_TUITION، DEFERRED_REVENUE…)
  systemKey     String?
  /// تصنيف قائمة التدفقات النقدية: CASH | OPERATING | INVESTING | FINANCING
  cashFlowGroup String?
  description   String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  createdById   String?
  updatedById   String?
  deletedAt     DateTime?

  lines JournalLine[]

  @@unique([tenantId, code])
  @@unique([tenantId, systemKey])
  @@index([tenantId, parentId])
}

/// مراكز التكلفة: الفرع، المرحلة، القسم
model CostCenter {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  /// BRANCH | STAGE | DEPARTMENT
  kind      String
  branchId  String?
  stageId   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
}

enum PeriodStatus {
  OPEN
  CLOSED
}

/// العام المالي (مستقل عن العام الدراسي)
model FiscalYear {
  id             String       @id @default(cuid())
  tenantId       String
  name           String
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  status         PeriodStatus @default(OPEN)
  closedAt       DateTime?
  closedById     String?
  closingEntryId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  periods FiscalPeriod[]

  @@unique([tenantId, name])
}

/// الفترة المحاسبية (شهر)
model FiscalPeriod {
  id           String       @id @default(cuid())
  tenantId     String
  fiscalYearId String
  fiscalYear   FiscalYear   @relation(fields: [fiscalYearId], references: [id])
  name         String
  startDate    DateTime     @db.Date
  endDate      DateTime     @db.Date
  status       PeriodStatus @default(OPEN)
  closedAt     DateTime?
  closedById   String?
  reopenReason String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  entries JournalEntry[]

  @@unique([fiscalYearId, startDate])
  @@index([tenantId, startDate])
}

enum JournalSource {
  MANUAL
  OPENING
  INVOICE
  CREDIT_NOTE
  RECEIPT
  RECEIPT_VOID
  CREDIT_APPLICATION
  REFUND
  PAYMENT_VOUCHER
  REVENUE_RECOGNITION
  CHEQUE
  CASH_SESSION
  BANK_TRANSFER
  WRITE_OFF
  CLOSING
  REVERSAL
  /// اعتماد مسير الرواتب
  PAYROLL
  /// صرف الرواتب من البنك
  PAYROLL_PAYMENT
  /// صرف سلفة موظف
  STAFF_LOAN
  /// تصفية نهاية الخدمة
  END_OF_SERVICE
  /// اقتناء أصل ثابت أو استبعاده
  FIXED_ASSET
  /// الإهلاك الشهري
  DEPRECIATION
  /// حركات المخزون (صرف، جرد، تسوية)
  INVENTORY
  /// استلام بضاعة من مورد
  GOODS_RECEIPT
  /// فاتورة مورد
  SUPPLIER_BILL
  /// سداد مورد
  SUPPLIER_PAYMENT
  /// مبيعات نقطة البيع (الزي والكتب والمقصف)
  SALE
  /// شحن محفظة الطالب وتسويتها
  WALLET
  /// مصروفات تشغيلية (صيانة، حافلات)
  OPERATING_EXPENSE
}

/// القيد اليومي — لا يُعدَّل بعد الترحيل (يُعكس بقيد)؛ التوازن مفروض بمشغّل في قاعدة البيانات
model JournalEntry {
  id                   String        @id @default(cuid())
  tenantId             String
  number               Int
  date                 DateTime      @db.Date
  periodId             String
  period               FiscalPeriod  @relation(fields: [periodId], references: [id])
  description          String
  source               JournalSource
  /// المستند المصدر (Invoice، Receipt…)
  sourceType           String?
  sourceId             String?
  reference            String?
  academicYearId       String?
  totalMinor           BigInt
  reversalOfId         String?       @unique
  isReversed           Boolean       @default(false)
  /// رُحّل في فترة مقفلة بصلاحية استثنائية
  postedInClosedPeriod Boolean       @default(false)
  createdById          String?
  createdAt            DateTime      @default(now())

  lines JournalLine[]

  @@unique([tenantId, number])
  @@index([tenantId, date])
  @@index([tenantId, sourceType, sourceId])
}

model JournalLine {
  id              String       @id @default(cuid())
  tenantId        String
  entryId         String
  entry           JournalEntry @relation(fields: [entryId], references: [id])
  accountId       String
  account         Account      @relation(fields: [accountId], references: [id])
  debitMinor      BigInt       @default(0)
  creditMinor     BigInt       @default(0)
  costCenterId    String?
  studentId       String?
  guardianId      String?
  description     String?
  /// المطابقة البنكية
  statementLineId String?      @unique
  reconciledAt    DateTime?

  @@index([tenantId, accountId])
  @@index([entryId])
  @@index([tenantId, guardianId])
}

model TaxCode {
  id              String   @id @default(cuid())
  tenantId        String
  code            String
  name            String
  /// النسبة بنقاط الأساس (1500 = ١٥٪)
  rateBp          Int
  /// STANDARD | ZERO | EXEMPT | OUT_OF_SCOPE
  kind            String
  outputAccountId String?
  inputAccountId  String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, code])
}

enum FeeKind {
  TUITION
  REGISTRATION
  TRANSPORT
  ACTIVITY
  BOOKS
  UNIFORM
  MEALS
  LATE_FEE
  OTHER
}

/// بند رسوم
model FeeItem {
  id                  String   @id @default(cuid())
  tenantId            String
  code                String
  name                String
  kind                FeeKind
  revenueAccountId    String
  receivableAccountId String
  /// إيراد مؤجل يُعترف به شهرياً على مدة العام الدراسي
  deferred            Boolean  @default(false)
  taxCodeId           String?
  /// رمز ضريبي بديل للمواطنين (مثل تحمّل الدولة للضريبة)
  citizenTaxCodeId    String?
  refundable          Boolean  @default(true)
  isActive            Boolean  @default(true)
  position            Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdById         String?
  updatedById         String?

  @@unique([tenantId, code])
}

/// جدول رسوم لعام دراسي × فرع × مرحلة × صف (الأكثر تحديداً يغلب)
model FeeSchedule {
  id             String   @id @default(cuid())
  tenantId       String
  academicYearId String
  name           String
  branchId       String?
  stageId        String?
  gradeId        String?
  isActive       Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?
  updatedById    String?

  lines FeeScheduleLine[]

  @@index([tenantId, academicYearId])
}

model FeeScheduleLine {
  id          String      @id @default(cuid())
  tenantId    String
  scheduleId  String
  schedule    FeeSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  feeItemId   String
  amountMinor Int
  /// اختياري (مثل النقل): لا يُفوتر إلا بطلب
  optional    Boolean     @default(false)

  @@unique([scheduleId, feeItemId])
}

/// خطة تقسيط: أجزاء بأوزان وتواريخ استحقاق، وغرامة تأخير اختيارية
model InstallmentPlan {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  /// SINGLE | TERMLY | MONTHLY | CUSTOM
  kind           String
  /// [{label, weight, dueDate}]
  parts          Json
  /// NONE | PERCENT | FIXED
  lateFeeKind    String   @default("NONE")
  /// نقاط أساس للنسبة أو هللات للمبلغ الثابت
  lateFeeValue   Int      @default(0)
  graceDays      Int      @default(0)
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  academicYearId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum DiscountKind {
  SIBLING
  STAFF
  MERIT
  SCHOLARSHIP
  EARLY_PAYMENT
  MANUAL
}

model DiscountType {
  id                 String       @id @default(cuid())
  tenantId           String
  code               String
  name               String
  kind               DiscountKind
  /// PERCENT (نقاط أساس) | FIXED (هللات)
  method             String
  value              Int
  /// خصم الأشقاء بترتيب الأخ: [{order: 2, valueBp: 500}, …]
  siblingTiers       Json?
  /// البنود المشمولة (فارغ = الرسوم الدراسية)
  feeItemIds         String[]
  validFrom          DateTime?    @db.Date
  validTo            DateTime?    @db.Date
  /// يتطلب موافقة إذا تجاوز الخصم هذا المبلغ (أو دائماً إن كان 0)
  approvalLimitMinor Int?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([tenantId, code])
}

model StudentDiscount {
  id                String   @id @default(cuid())
  tenantId          String
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id])
  discountTypeId    String
  academicYearId    String
  /// قيمة بديلة لقيمة النوع
  valueOverride     Int?
  /// ACTIVE | PENDING | REJECTED | REVOKED
  status            String   @default("ACTIVE")
  approvalRequestId String?
  note              String?
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId, studentId])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  CANCELLED
}

model InvoiceBatch {
  id             String   @id @default(cuid())
  tenantId       String
  number         Int
  academicYearId String
  description    String
  scope          Json
  count          Int
  totalMinor     Int
  createdById    String?
  createdAt      DateTime @default(now())

  @@unique([tenantId, number])
}

/// الفاتورة — الرقم التسلسلي يُسند عند الإصدار دون انقطاع
model Invoice {
  id                String        @id @default(cuid())
  tenantId          String
  number            Int?
  status            InvoiceStatus @default(DRAFT)
  studentId         String
  student           Student       @relation(fields: [studentId], references: [id])
  guardianId        String?
  guardian          Guardian?     @relation(fields: [guardianId], references: [id])
  branchId          String
  academicYearId    String
  costCenterId      String?
  issueDate         DateTime?     @db.Date
  dueDate           DateTime      @db.Date
  subtotalMinor     Int
  discountMinor     Int           @default(0)
  taxMinor          Int           @default(0)
  totalMinor        Int
  paidMinor         Int           @default(0)
  creditedMinor     Int           @default(0)
  /// MANUAL | BULK | ADMISSION | ACTIVITY | LATE_FEE | DEBIT_NOTE | TRANSFER
  source            String        @default("MANUAL")
  sourceId          String?
  batchId           String?
  installmentPlanId String?
  notes             String?
  journalEntryId    String?
  cancelReason      String?
  cancelledAt       DateTime?
  remindersPaused   Boolean       @default(false)
  reminderLevel     Int           @default(0)
  lastReminderAt    DateTime?
  customValues      Json          @default("{}")
  position          Float         @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  createdById       String?
  updatedById       String?
  deletedAt         DateTime?

  lines        InvoiceLine[]
  installments InvoiceInstallment[]
  allocations  ReceiptAllocation[]
  creditNotes  CreditNote[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, studentId])
  @@index([tenantId, guardianId])
  @@index([tenantId, dueDate])
}

model InvoiceLine {
  id                  String    @id @default(cuid())
  tenantId            String
  invoiceId           String
  invoice             Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeItemId           String?
  description         String
  quantity            Int       @default(1)
  unitMinor           Int
  amountMinor         Int
  discountMinor       Int       @default(0)
  taxCodeId           String?
  taxRateBp           Int       @default(0)
  taxMinor            Int       @default(0)
  totalMinor          Int
  revenueAccountId    String
  receivableAccountId String
  deferred            Boolean   @default(false)
  /// ما اعتُرف به من الإيراد المؤجل
  recognizedMinor     Int       @default(0)
  /// ما خُفّض بإشعارات دائنة (قبل الضريبة)
  creditedMinor       Int       @default(0)
  /// تفصيل الخصومات: [{id, name, amountMinor}]
  discountDetail      Json      @default("[]")
  serviceStart        DateTime? @db.Date
  serviceEnd          DateTime? @db.Date
  position            Int       @default(0)
}

model InvoiceInstallment {
  id               String   @id @default(cuid())
  tenantId         String
  invoiceId        String
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  seq              Int
  label            String
  dueDate          DateTime @db.Date
  amountMinor      Int
  paidMinor        Int      @default(0)
  lateFeeInvoiceId String?

  @@unique([invoiceId, seq])
}

/// إشعار دائن: تخفيض فاتورة صادرة (تعديل، إلغاء، تناسب عند الانسحاب)
model CreditNote {
  id             String   @id @default(cuid())
  tenantId       String
  number         Int
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  date           DateTime @db.Date
  /// ADJUSTMENT | CANCELLATION | PRORATION | DISCOUNT
  kind           String
  reason         String
  amountMinor    Int
  taxMinor       Int
  totalMinor     Int
  journalEntryId String?
  /// المصدر (Transfer، ActivityRegistration…)
  sourceType     String?
  sourceId       String?
  createdById    String?
  createdAt      DateTime @default(now())

  @@unique([tenantId, number])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  SADAD
}

/// سند القبض
model Receipt {
  id              String        @id @default(cuid())
  tenantId        String
  number          Int
  date            DateTime      @db.Date
  guardianId      String?
  studentId       String?
  payerName       String
  method          PaymentMethod
  amountMinor     Int
  /// ما لم يُخصَّص على فواتير (يصبح رصيداً دائناً للأسرة)
  unappliedMinor  Int           @default(0)
  reference       String?
  bankAccountId   String?
  chequeNumber    String?
  chequeBank      String?
  chequeDate      DateTime?     @db.Date
  /// PENDING | CLEARED | BOUNCED
  chequeStatus    String?
  chequeUpdatedAt DateTime?
  cashSessionId   String?
  branchId        String?
  /// POSTED | VOID
  status          String        @default("POSTED")
  voidReason      String?
  journalEntryId  String?
  notes           String?
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  allocations ReceiptAllocation[]

  @@unique([tenantId, number])
  @@index([tenantId, guardianId])
  @@index([tenantId, date])
}

/// تخصيص دفعة (أو رصيد دائن) على فاتورة/قسط
model ReceiptAllocation {
  id            String    @id @default(cuid())
  tenantId      String
  receiptId     String?
  receipt       Receipt?  @relation(fields: [receiptId], references: [id])
  invoiceId     String
  invoice       Invoice   @relation(fields: [invoiceId], references: [id])
  installmentId String?
  amountMinor   Int
  /// RECEIPT | CREDIT
  source        String    @default("RECEIPT")
  reversedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId, invoiceId])
}

/// دفتر الأرصدة الدائنة للأسرة (+ دخول، − استخدام/استرداد)
model GuardianCredit {
  id          String   @id @default(cuid())
  tenantId    String
  guardianId  String
  studentId   String?
  amountMinor Int
  /// OVERPAYMENT | CREDIT_NOTE | APPLIED | REFUND | RECEIPT_VOID
  source      String
  sourceId    String?
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([tenantId, guardianId])
}

model Refund {
  id                String        @id @default(cuid())
  tenantId          String
  number            Int
  guardianId        String
  amountMinor       Int
  method            PaymentMethod
  bankAccountId     String?
  reason            String
  /// PENDING | APPROVED | PAID | REJECTED
  status            String        @default("PENDING")
  approvalRequestId String?
  journalEntryId    String?
  paidAt            DateTime?
  createdById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([tenantId, number])
}

/// سند الصرف (مصروفات وموردون) بموافقات حسب المبلغ
model PaymentVoucher {
  id                String        @id @default(cuid())
  tenantId          String
  number            Int
  date              DateTime      @db.Date
  payee             String
  expenseAccountId  String
  costCenterId      String?
  method            PaymentMethod
  bankAccountId     String?
  amountMinor       Int
  taxCodeId         String?
  taxMinor          Int           @default(0)
  totalMinor        Int
  description       String
  attachments       Json          @default("[]")
  /// PENDING | APPROVED | PAID | REJECTED | CANCELLED
  status            String        @default("PENDING")
  approvalRequestId String?
  journalEntryId    String?
  paidAt            DateTime?
  customValues      Json          @default("{}")
  position          Float         @default(0)
  createdById       String?
  updatedById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model BankAccount {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  bankName  String
  iban      String
  /// حساب الأستاذ المقابل
  accountId String   @unique
  branchId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statementLines BankStatementLine[]
}

/// سطر كشف حساب بنكي مستورد (موجب = إيداع، سالب = سحب)
model BankStatementLine {
  id            String      @id @default(cuid())
  tenantId      String
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  date          DateTime    @db.Date
  description   String
  reference     String?
  amountMinor   Int
  importBatch   String
  matchedAt     DateTime?
  matchedById   String?
  createdAt     DateTime    @default(now())

  @@index([bankAccountId, date])
}

/// وردية أمين الصندوق
model CashSession {
  id                String    @id @default(cuid())
  tenantId          String
  cashierId         String
  branchId          String?
  openedAt          DateTime  @default(now())
  openingFloatMinor Int       @default(0)
  closedAt          DateTime?
  expectedMinor     Int?
  countedMinor      Int?
  differenceMinor   Int?
  differenceEntryId String?
  /// OPEN | CLOSED
  status            String    @default("OPEN")
  note              String?

  @@index([tenantId, cashierId, status])
}

// =====================================================================
// المرحلة ٤ — التقييم والدرجات
// الدرجات بأعشار الدرجة (Int) والنسب بنقاط الأساس؛ لا float في التخزين
// =====================================================================

/// نظام التقييم لمرحلة (أو افتراضي للمدرسة): مكونات بأوزان، درجة النجاح، والتقديرات
model GradingScheme {
  id                     String   @id @default(cuid())
  tenantId               String
  /// null = النظام الافتراضي للمدرسة
  stageId                String?
  name                   String
  /// [{key, name, weight}] — مجموع الأوزان ١٠٠
  components             Json
  /// درجة النجاح في المادة (نقاط أساس من ١٠٠٪)
  passBp                 Int      @default(5000)
  /// التقديرات: [{minBp, label, letter, points}] من الأعلى للأدنى
  bands                  Json
  /// أقصى عدد مواد للدور الثاني؛ أكثر منها رسوب (إعادة)
  maxSecondRoundSubjects Int      @default(3)
  /// طريقة عرض الدرجة في الشهادة: PERCENT | LETTER | POINTS
  display                String   @default("PERCENT")
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  createdById            String?
  updatedById            String?

  @@index([tenantId, stageId])
}

enum ExamKind {
  /// يومي/قصير
  DAILY
  /// شهري
  MONTHLY
  /// منتصف الفصل
  MIDTERM
  /// نهائي
  FINAL
}

/// دورة اختبارات (فترة اختبارات لصفوف محددة) بجلساتها ولجانها
model Exam {
  id             String    @id @default(cuid())
  tenantId       String
  number         Int
  academicYearId String
  termId         String
  branchId       String?
  title          String
  kind           ExamKind  @default(MIDTERM)
  /// مكوّن نظام التقييم الذي تغذيه (مثل midterm أو final)
  componentKey   String
  gradeIds       String[]
  startDate      DateTime  @db.Date
  endDate        DateTime  @db.Date
  /// PLANNED | SCHEDULED | RUNNING | GRADING | DONE
  status         String    @default("PLANNED")
  instructions   String?
  customValues   Json      @default("{}")
  position       Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?

  sessions   ExamSession[]
  committees ExamCommittee[]
  seats      ExamSeat[]

  @@unique([tenantId, number])
  @@index([tenantId, termId])
}

/// جلسة اختبار مادة لصف في يوم ووقت
model ExamSession {
  id          String   @id @default(cuid())
  tenantId    String
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  gradeId     String
  subjectId   String
  date        DateTime @db.Date
  /// HH:MM
  startTime   String
  durationMin Int      @default(90)
  /// الدرجة العظمى بالأعشار
  maxTenths   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reports InvigilationReport[]

  @@unique([examId, gradeId, subjectId])
  @@index([tenantId, date])
}

/// لجنة اختبار: قاعة ومراقبون
model ExamCommittee {
  id             String   @id @default(cuid())
  tenantId       String
  examId         String
  exam           Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  branchId       String
  number         Int
  roomId         String?
  name           String
  capacity       Int      @default(20)
  invigilatorIds String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  seats ExamSeat[]

  @@unique([examId, number])
}

/// مقعد الطالب في لجنة برقم جلوس
model ExamSeat {
  id          String        @id @default(cuid())
  tenantId    String
  examId      String
  exam        Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  committeeId String
  committee   ExamCommittee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  studentId   String
  seatNumber  Int

  @@unique([examId, studentId])
  @@unique([examId, seatNumber])
  @@index([committeeId])
}

/// محضر مراقبة لجلسة ولجنة: الغياب والملاحظات والمخالفات
model InvigilationReport {
  id               String      @id @default(cuid())
  tenantId         String
  sessionId        String
  session          ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  committeeId      String
  absentStudentIds String[]
  /// [{studentId, kind, note}]
  incidents        Json        @default("[]")
  notes            String?
  submittedById    String?
  submittedAt      DateTime    @default(now())

  @@unique([sessionId, committeeId])
}

enum AssessmentStatus {
  DRAFT
  /// أرسلها المعلم للاعتماد
  SUBMITTED
  /// اعتمدها رئيس القسم
  REVIEWED
  /// اعتمدها الوكيل — مقفلة
  APPROVED
}

/// بند تقييم لفصل ومادة في فصل دراسي (اختبار، مشاركة، واجب، مشروع…)
model Assessment {
  id            String           @id @default(cuid())
  tenantId      String
  termId        String
  sectionId     String
  subjectId     String
  teacherId     String?
  componentKey  String
  title         String
  maxTenths     Int
  date          DateTime?        @db.Date
  examSessionId String?
  status        AssessmentStatus @default(DRAFT)
  submittedAt   DateTime?
  submittedById String?
  reviewedAt    DateTime?
  reviewedById  String?
  approvedAt    DateTime?
  approvedById  String?
  /// ملاحظة الإعادة للمعلم
  returnNote    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  createdById   String?
  updatedById   String?

  marks          Mark[]
  changeRequests GradeChangeRequest[]

  @@index([tenantId, termId, sectionId, subjectId])
  @@index([tenantId, status])
}

/// درجة طالب في بند تقييم (بالأعشار)
model Mark {
  id           String     @id @default(cuid())
  tenantId     String
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  scoreTenths  Int?
  absent       Boolean    @default(false)
  /// غياب بعذر: لا يُحتسب البند للطالب
  excused      Boolean    @default(false)
  note         String?
  updatedById  String?
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, studentId])
  @@index([tenantId, studentId])
}

/// طلب تعديل درجة بعد اعتمادها (بموافقة، ويُسجَّل)
model GradeChangeRequest {
  id                String     @id @default(cuid())
  tenantId          String
  number            Int
  assessmentId      String
  assessment        Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId         String
  oldTenths         Int?
  newTenths         Int?
  oldAbsent         Boolean    @default(false)
  newAbsent         Boolean    @default(false)
  reason            String
  /// PENDING | APPROVED | REJECTED | APPLIED
  status            String     @default("PENDING")
  approvalRequestId String?
  requestedById     String?
  appliedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

/// قالب الشهادة: كتل مرتبة بالسحب مع التواقيع والختم
model ReportCardTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  /// [{type, enabled, title?}] بالترتيب
  blocks      Json
  /// [{title, name}]
  signatures  Json     @default("[]")
  stampUrl    String?
  footerNote  String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?
}

/// نشر نتائج فصل دراسي: تاريخ الإتاحة لأولياء الأمور وحجب المدينين
model ResultPublication {
  id             String   @id @default(cuid())
  tenantId       String
  termId         String   @unique
  publishAt      DateTime
  withholdOnDebt Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// شهادة صادرة (لقطة من النتائج وقت الإصدار) برمز تحقق
model ReportCard {
  id         String   @id @default(cuid())
  tenantId   String
  termId     String
  studentId  String
  sectionId  String?
  verifyCode String   @unique
  /// لقطة النتائج: المواد والمكونات والمعدل والترتيب والحضور
  snapshot   Json
  averageBp  Int
  rank       Int?
  /// PASS | SECOND_ROUND | FAIL | INCOMPLETE
  result     String
  templateId String?
  issuedAt   DateTime @default(now())
  issuedById String?
  updatedAt  DateTime @updatedAt

  @@unique([termId, studentId])
  @@index([tenantId, termId])
}

// =====================================================================
// المرحلة ٤ — الموارد البشرية
// =====================================================================

/// إدارة/قسم في الهيكل التنظيمي
model Department {
  id             String       @id @default(cuid())
  tenantId       String
  code           String
  name           String
  parentId       String?
  parent         Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children       Department[] @relation("DepartmentTree")
  headEmployeeId String?
  /// ACADEMIC | ADMIN | SERVICES — يحدد حساب مصروف الرواتب
  category       String       @default("ADMIN")
  costCenterId   String?
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?

  positions Position[]
  employees Employee[]

  @@unique([tenantId, code])
}

/// مسمى وظيفي في قسم
model Position {
  id           String     @id @default(cuid())
  tenantId     String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  title        String
  /// عدد الشواغر المعتمدة
  headcount    Int        @default(1)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  employees Employee[]
}

enum EmployeeStatus {
  ACTIVE
  /// في إجازة طويلة
  ON_LEAVE
  SUSPENDED
  /// انتهت خدمته
  TERMINATED
}

/// ملف الموظف
model Employee {
  id                String         @id @default(cuid())
  tenantId          String
  number            Int
  /// حساب الدخول (للموظفين الذين يستخدمون المنصة)
  userId            String?        @unique
  branchId          String?
  departmentId      String?
  department        Department?    @relation(fields: [departmentId], references: [id])
  positionId        String?
  positionRef       Position?      @relation(fields: [positionId], references: [id])
  managerId         String?
  manager           Employee?      @relation("EmployeeManager", fields: [managerId], references: [id])
  reports           Employee[]     @relation("EmployeeManager")
  fullName          String
  gender            Gender         @default(MALE)
  birthDate         DateTime?      @db.Date
  nationality       String         @default("SA")
  maritalStatus     String?
  idType            IdType         @default(NATIONAL_ID)
  /// الهوية مشفّرة مع بصمة للبحث (كما في الطلاب)
  nationalIdHash    String?
  nationalIdEnc     String?
  nationalIdLast4   String?
  idExpiry          DateTime?      @db.Date
  passportNumber    String?
  passportExpiry    DateTime?      @db.Date
  phone             String?
  email             String?
  address           String?
  /// [{degree, major, institution, year}]
  qualifications    Json           @default("[]")
  /// [{employer, title, from, to}]
  experiences       Json           @default("[]")
  bankName          String?
  iban              String?
  /// الكفيل أو الجهة (لغير السعوديين)
  sponsor           String?
  hireDate          DateTime       @db.Date
  status            EmployeeStatus @default(ACTIVE)
  terminationDate   DateTime?      @db.Date
  terminationReason String?
  /// ACADEMIC | ADMIN | SERVICES
  category          String         @default("ADMIN")
  shiftId           String?
  /// مسجّل في التأمينات الاجتماعية
  gosiRegistered    Boolean        @default(true)
  attachments       Json           @default("[]")
  photoUrl          String?
  notes             String?
  customValues      Json           @default("{}")
  position          Float          @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  createdById       String?
  updatedById       String?
  deletedAt         DateTime?

  contracts     EmploymentContract[]
  attendance    EmployeeAttendance[]
  leaveBalances LeaveBalance[]
  leaveRequests StaffLeaveRequest[]
  loans         EmployeeLoan[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

/// عقد العمل وهيكل الراتب
model EmploymentContract {
  id              String    @id @default(cuid())
  tenantId        String
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id])
  number          Int
  /// FIXED | UNLIMITED | PART_TIME
  type            String    @default("FIXED")
  startDate       DateTime  @db.Date
  endDate         DateTime? @db.Date
  probationEnd    DateTime? @db.Date
  basicMinor      Int
  housingMinor    Int       @default(0)
  transportMinor  Int       @default(0)
  /// [{name, amountMinor}]
  otherAllowances Json      @default("[]")
  hoursPerDay     Int       @default(8)
  annualLeaveDays Int       @default(21)
  /// ACTIVE | ENDED
  status          String    @default("ACTIVE")
  attachments     Json      @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?
  updatedById     String?

  @@unique([tenantId, number])
  @@index([employeeId, status])
}

/// وظيفة شاغرة
model JobOpening {
  id           String    @id @default(cuid())
  tenantId     String
  number       Int
  title        String
  departmentId String?
  positionId   String?
  branchId     String?
  description  String?
  requirements String?
  openings     Int       @default(1)
  /// OPEN | ON_HOLD | CLOSED
  status       String    @default("OPEN")
  closingDate  DateTime? @db.Date
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?
  updatedById  String?
  deletedAt    DateTime?

  applications JobApplication[]

  @@unique([tenantId, number])
}

enum ApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

/// طلب توظيف (لوحة كانبان بالمراحل)
model JobApplication {
  id               String           @id @default(cuid())
  tenantId         String
  number           Int
  openingId        String
  opening          JobOpening       @relation(fields: [openingId], references: [id])
  fullName         String
  email            String?
  phone            String?
  nationality      String           @default("SA")
  gender           Gender           @default(MALE)
  qualification    String?
  experienceYears  Int              @default(0)
  stage            ApplicationStage @default(APPLIED)
  interviewAt      DateTime?
  /// ١–٥
  rating           Int?
  offerSalaryMinor Int?
  cv               Json?
  notes            String?
  employeeId       String?
  customValues     Json             @default("{}")
  position         Float            @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  createdById      String?
  updatedById      String?
  deletedAt        DateTime?

  @@unique([tenantId, number])
  @@index([tenantId, stage])
}

/// الدوام/الوردية
model WorkShift {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  /// HH:MM
  startTime    String
  endTime      String
  graceMinutes Int      @default(10)
  /// ٠=الأحد … ٦=السبت
  workDays     Int[]
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum StaffAttendanceStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
  HOLIDAY
  /// غياب بعذر مقبول (لا خصم)
  EXCUSED
}

/// حضور الموظف اليومي
model EmployeeAttendance {
  id                String                @id @default(cuid())
  tenantId          String
  employeeId        String
  employee          Employee              @relation(fields: [employeeId], references: [id])
  date              DateTime              @db.Date
  checkIn           DateTime?
  checkOut          DateTime?
  status            StaffAttendanceStatus @default(PRESENT)
  lateMinutes       Int                   @default(0)
  earlyLeaveMinutes Int                   @default(0)
  overtimeMinutes   Int                   @default(0)
  /// MANUAL | DEVICE | SELF | LEAVE
  source            String                @default("MANUAL")
  note              String?
  updatedById       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([employeeId, date])
  @@index([tenantId, date])
}

/// نوع إجازة وسياسة استحقاقه
model LeaveType {
  id                 String   @id @default(cuid())
  tenantId           String
  code               String
  name               String
  paid               Boolean  @default(true)
  /// الاستحقاق السنوي بالأيام (null = بلا رصيد)
  annualDays         Int?
  /// YEARLY | MONTHLY | NONE
  accrual            String   @default("YEARLY")
  requiresAttachment Boolean  @default(false)
  maxPerRequest      Int?
  carryOverDays      Int      @default(0)
  /// FEMALE | MALE | null
  gender             String?
  color              String   @default("teal")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, code])
}

/// رصيد إجازة موظف لنوع وسنة
model LeaveBalance {
  id           String   @id @default(cuid())
  tenantId     String
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  leaveTypeId  String
  year         Int
  entitledDays Int      @default(0)
  carriedDays  Int      @default(0)
  usedDays     Int      @default(0)
  adjustedDays Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([employeeId, leaveTypeId, year])
}

/// طلب إجازة موظف (بموافقة المدير المباشر ثم الموارد البشرية)
model StaffLeaveRequest {
  id                String    @id @default(cuid())
  tenantId          String
  number            Int
  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId       String
  startDate         DateTime  @db.Date
  endDate           DateTime  @db.Date
  days              Int
  reason            String?
  attachments       Json      @default("[]")
  /// PENDING | APPROVED | REJECTED | CANCELLED
  status            String    @default("PENDING")
  approvalRequestId String?
  decidedAt         DateTime?
  customValues      Json      @default("{}")
  position          Float     @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdById       String?
  updatedById       String?
  deletedAt         DateTime?

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

/// سلفة موظف تُستقطع بأقساط شهرية
model EmployeeLoan {
  id                String   @id @default(cuid())
  tenantId          String
  number            Int
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id])
  amountMinor       Int
  installmentMinor  Int
  /// أول شهر للاستقطاع YYYY-MM
  startMonth        String
  repaidMinor       Int      @default(0)
  /// PENDING | ACTIVE | SETTLED | REJECTED
  status            String   @default("PENDING")
  reason            String?
  approvalRequestId String?
  journalEntryId    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdById       String?

  @@unique([tenantId, number])
}

/// بند متغير على راتب شهر: مكافأة، إضافي، جزاء، استقطاع أو بدل آخر
model PayrollAdjustment {
  id           String   @id @default(cuid())
  tenantId     String
  employeeId   String
  /// YYYY-MM
  month        String
  /// BONUS | OVERTIME | PENALTY | DEDUCTION | ALLOWANCE
  kind         String
  amountMinor  Int
  /// ساعات الإضافي (للاحتساب)
  hours        Int?
  description  String
  payrollRunId String?
  createdById  String?
  createdAt    DateTime @default(now())

  @@index([tenantId, month])
}

/// مسير رواتب شهري
model PayrollRun {
  id                String    @id @default(cuid())
  tenantId          String
  number            Int
  /// YYYY-MM
  month             String
  periodStart       DateTime  @db.Date
  periodEnd         DateTime  @db.Date
  /// DRAFT | REVIEW | APPROVED | PAID | CANCELLED
  status            String    @default("DRAFT")
  grossMinor        Int       @default(0)
  deductionsMinor   Int       @default(0)
  netMinor          Int       @default(0)
  employerGosiMinor Int       @default(0)
  eosAccrualMinor   Int       @default(0)
  employees         Int       @default(0)
  approvalRequestId String?
  approvedAt        DateTime?
  approvedById      String?
  paidAt            DateTime?
  bankAccountId     String?
  journalEntryId    String?
  paymentEntryId    String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdById       String?
  updatedById       String?

  lines PayrollLine[]

  @@unique([tenantId, number])
  @@unique([tenantId, month])
}

/// سطر موظف في المسير
model PayrollLine {
  id                   String     @id @default(cuid())
  tenantId             String
  runId                String
  run                  PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId           String
  departmentId         String?
  category             String
  branchId             String?
  basicMinor           Int
  housingMinor         Int        @default(0)
  transportMinor       Int        @default(0)
  otherAllowancesMinor Int        @default(0)
  overtimeMinor        Int        @default(0)
  bonusMinor           Int        @default(0)
  grossMinor           Int
  gosiEmployeeMinor    Int        @default(0)
  gosiEmployerMinor    Int        @default(0)
  absenceMinor         Int        @default(0)
  lateMinor            Int        @default(0)
  unpaidLeaveMinor     Int        @default(0)
  loanMinor            Int        @default(0)
  penaltyMinor         Int        @default(0)
  otherDeductionMinor  Int        @default(0)
  deductionsMinor      Int        @default(0)
  netMinor             Int
  eosAccrualMinor      Int        @default(0)
  /// أيام العمل والغياب والتأخر وتفاصيل البنود
  details              Json       @default("{}")
  iban                 String?

  @@unique([runId, employeeId])
}

/// تصفية نهاية الخدمة
model EndOfService {
  id                   String   @id @default(cuid())
  tenantId             String
  number               Int
  employeeId           String
  /// RESIGNATION | TERMINATION | CONTRACT_END | RETIREMENT | DEATH
  reason               String
  lastWorkingDay       DateTime @db.Date
  serviceDays          Int
  /// الأجر الأساس للمكافأة (أساسي + سكن)
  wageMinor            Int
  eosMinor             Int
  leaveDays            Int      @default(0)
  leaveEncashmentMinor Int      @default(0)
  unpaidSalaryMinor    Int      @default(0)
  loanBalanceMinor     Int      @default(0)
  otherDeductionsMinor Int      @default(0)
  netMinor             Int
  /// خطوات الحساب للعرض والتدقيق
  calculation          Json
  /// DRAFT | APPROVED | PAID | CANCELLED
  status               String   @default("DRAFT")
  approvalRequestId    String?
  journalEntryId       String?
  paymentEntryId       String?
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  createdById          String?

  @@unique([tenantId, number])
  @@index([tenantId, employeeId])
}

/// قالب تقييم أداء: معايير بأوزان
model ReviewTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  /// [{key, name, weight, description}]
  criteria  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// دورة تقييم أداء
model ReviewCycle {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  templateId  String
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  /// OPEN | CLOSED
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  reviews PerformanceReview[]
}

/// تقييم أداء موظف في دورة
model PerformanceReview {
  id                 String      @id @default(cuid())
  tenantId           String
  cycleId            String
  cycle              ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId         String
  reviewerId         String?
  /// {criterionKey: 1..5}
  selfScores         Json        @default("{}")
  managerScores      Json        @default("{}")
  /// [{title, target, progressBp}]
  goals              Json        @default("[]")
  selfComment        String?
  managerComment     String?
  selfSubmittedAt    DateTime?
  managerSubmittedAt DateTime?
  /// النتيجة النهائية بنقاط الأساس من ١٠٠٪
  finalBp            Int?
  rating             String?
  /// PENDING_SELF | PENDING_MANAGER | COMPLETED
  status             String      @default("PENDING_SELF")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([cycleId, employeeId])
}

// =====================================================================
// المرحلة ٥: العمليات — الموازنة، الأصول الثابتة، المخزون والمشتريات، نقطة البيع،
// الصيانة وحجز المرافق، المواصلات، المكتبة، الأمن والسلامة والعيادة، المقصف والمحافظ
// =====================================================================

/// الموازنة السنوية: حساب × مركز تكلفة × شهر، باعتماد
model Budget {
  id                String       @id @default(cuid())
  tenantId          String
  fiscalYearId      String
  name              String
  /// DRAFT | PENDING | APPROVED | REJECTED
  status            String       @default("DRAFT")
  approvalRequestId String?
  approvedAt        DateTime?
  notes             String?
  createdById       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  lines             BudgetLine[]

  @@unique([tenantId, fiscalYearId, name])
}

model BudgetLine {
  id           String  @id @default(cuid())
  tenantId     String
  budgetId     String
  budget       Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  accountId    String
  costCenterId String?
  /// YYYY-MM
  month        String
  amountMinor  Int

  @@index([tenantId, accountId, month])
  @@index([budgetId])
}

/// فئة أصول: حساباتها وطريقة إهلاكها الافتراضية
model AssetCategory {
  id               String       @id @default(cuid())
  tenantId         String
  code             String
  name             String
  assetAccountId   String
  accumAccountId   String
  expenseAccountId String
  /// STRAIGHT_LINE | DECLINING
  method           String       @default("STRAIGHT_LINE")
  usefulLifeMonths Int
  /// نسبة القسط المتناقص السنوية (نقاط أساس)
  decliningRateBp  Int?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  assets           FixedAsset[]

  @@unique([tenantId, code])
}

/// أصل ثابت
model FixedAsset {
  id                    String          @id @default(cuid())
  tenantId              String
  number                Int
  /// رقم الملصق/الباركود
  tag                   String
  name                  String
  categoryId            String
  category              AssetCategory   @relation(fields: [categoryId], references: [id])
  branchId              String?
  roomId                String?
  location              String?
  serialNumber          String?
  supplierId            String?
  custodianId           String?
  costCenterId          String?
  purchaseDate          DateTime        @db.Date
  inServiceDate         DateTime        @db.Date
  costMinor             Int
  salvageMinor          Int             @default(0)
  usefulLifeMonths      Int
  method                String          @default("STRAIGHT_LINE")
  decliningRateBp       Int?
  /// مجمع الإهلاك حتى آخر شهر مرحّل (يشمل الافتتاحي)
  accumulatedMinor      Int             @default(0)
  /// آخر شهر أُهلك YYYY-MM
  lastDepreciatedMonth  String?
  /// ACTIVE | FULLY_DEPRECIATED | DISPOSED
  status                String          @default("ACTIVE")
  acquisitionEntryId    String?
  disposalEntryId       String?
  disposedAt            DateTime?       @db.Date
  disposalProceedsMinor Int?
  disposalGainMinor     Int?
  notes                 String?
  attachments           Json            @default("[]")
  createdById           String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  deletedAt             DateTime?
  movements             AssetMovement[]

  @@unique([tenantId, number])
  @@unique([tenantId, tag])
  @@index([tenantId, status])
}

model AssetMovement {
  id          String     @id @default(cuid())
  tenantId    String
  assetId     String
  asset       FixedAsset @relation(fields: [assetId], references: [id])
  /// ACQUISITION | TRANSFER | DISPOSAL | DEPRECIATION_COMPLETE
  kind        String
  date        DateTime   @db.Date
  fromText    String?
  toText      String?
  notes       String?
  createdById String?
  createdAt   DateTime   @default(now())
}

/// إهلاك شهر: قيد واحد لكل الأصول
model DepreciationRun {
  id             String             @id @default(cuid())
  tenantId       String
  month          String
  totalMinor     Int
  assets         Int
  journalEntryId String?
  createdById    String?
  createdAt      DateTime           @default(now())
  lines          DepreciationLine[]

  @@unique([tenantId, month])
}

model DepreciationLine {
  id             String          @id @default(cuid())
  tenantId       String
  runId          String
  run            DepreciationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  assetId        String
  amountMinor    Int
  bookValueMinor Int
}

// ---------------------------------------------------------------------
// المخزون والمشتريات
// ---------------------------------------------------------------------

model Warehouse {
  id        String       @id @default(cuid())
  tenantId  String
  code      String
  name      String
  branchId  String?
  /// STORE (زي وكتب) | SUPPLIES | CANTEEN | MAINTENANCE | CLINIC
  kind      String       @default("SUPPLIES")
  keeperId  String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  levels    StockLevel[]

  @@unique([tenantId, code])
}

/// صنف مخزون (تكلفة بالمتوسط المرجّح على مستوى الصنف)
model InventoryItem {
  id                 String       @id @default(cuid())
  tenantId           String
  sku                String
  barcode            String?
  name               String
  /// UNIFORM | BOOK | SUPPLY | CANTEEN | SPARE_PART | MEDICAL | OTHER
  category           String       @default("SUPPLY")
  unit               String       @default("حبة")
  minQty             Int          @default(0)
  reorderQty         Int          @default(0)
  /// الكمية الكلية وقيمتها (المتوسط = القيمة ÷ الكمية)
  onHandQty          Int          @default(0)
  stockValueMinor    Int          @default(0)
  sellable           Boolean      @default(false)
  salePriceMinor     Int?
  taxCodeId          String?
  inventoryAccountId String
  cogsAccountId      String?
  revenueAccountId   String?
  /// حساب المصروف عند الصرف للأقسام
  expenseAccountId   String?
  imageUrl           String?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?
  levels             StockLevel[]

  @@unique([tenantId, sku])
  @@index([tenantId, category])
}

model StockLevel {
  id          String        @id @default(cuid())
  tenantId    String
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id])
  warehouseId String
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  quantity    Int           @default(0)

  @@unique([itemId, warehouseId])
}

model StockMovement {
  id             String   @id @default(cuid())
  tenantId       String
  number         Int
  itemId         String
  warehouseId    String
  /// OPENING | RECEIPT | ISSUE | SALE | SALE_RETURN | ADJUSTMENT | TRANSFER_IN | TRANSFER_OUT
  kind           String
  /// موجبة للوارد وسالبة للصادر
  quantity       Int
  unitCostMinor  Int
  valueMinor     Int
  date           DateTime @db.Date
  reference      String?
  sourceType     String?
  sourceId       String?
  costCenterId   String?
  journalEntryId String?
  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())

  @@unique([tenantId, number])
  @@index([tenantId, itemId, date])
}

model Supplier {
  id               String           @id @default(cuid())
  tenantId         String
  number           Int
  name             String
  taxNumber        String?
  crNumber         String?
  contactName      String?
  phone            String?
  email            String?
  address          String?
  iban             String?
  paymentTermsDays Int              @default(30)
  category         String?
  notes            String?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  ratings          SupplierRating[]

  @@unique([tenantId, number])
}

model SupplierRating {
  id          String   @id @default(cuid())
  tenantId    String
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  orderId     String?
  quality     Int
  delivery    Int
  price       Int
  comment     String?
  createdById String?
  createdAt   DateTime @default(now())
}

model PurchaseRequest {
  id                  String                @id @default(cuid())
  tenantId            String
  number              Int
  title               String
  branchId            String?
  costCenterId        String?
  requestedById       String
  neededBy            DateTime?             @db.Date
  justification       String?
  /// DRAFT | PENDING | APPROVED | REJECTED | ORDERED | CANCELLED
  status              String                @default("DRAFT")
  approvalRequestId   String?
  estimatedTotalMinor Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  lines               PurchaseRequestLine[]

  @@unique([tenantId, number])
}

model PurchaseRequestLine {
  id           String          @id @default(cuid())
  tenantId     String
  requestId    String
  request      PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemId       String?
  description  String
  quantity     Int
  estUnitMinor Int             @default(0)
}

model PurchaseOrder {
  id            String              @id @default(cuid())
  tenantId      String
  number        Int
  supplierId    String
  requestId     String?
  warehouseId   String
  orderDate     DateTime            @db.Date
  expectedDate  DateTime?           @db.Date
  /// DRAFT | ISSUED | PARTIAL | RECEIVED | CLOSED | CANCELLED
  status        String              @default("DRAFT")
  subtotalMinor Int                 @default(0)
  taxMinor      Int                 @default(0)
  totalMinor    Int                 @default(0)
  costCenterId  String?
  notes         String?
  createdById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  lines         PurchaseOrderLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model PurchaseOrderLine {
  id               String        @id @default(cuid())
  tenantId         String
  orderId          String
  order            PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// صنف مخزني أو (عند غيابه) خدمة/مصروف مباشر على حساب
  itemId           String?
  expenseAccountId String?
  description      String
  quantity         Int
  unitMinor        Int
  taxBp            Int           @default(0)
  receivedQty      Int           @default(0)
  billedQty        Int           @default(0)
}

model GoodsReceipt {
  id             String             @id @default(cuid())
  tenantId       String
  number         Int
  orderId        String
  warehouseId    String
  date           DateTime           @db.Date
  notes          String?
  journalEntryId String?
  createdById    String?
  createdAt      DateTime           @default(now())
  lines          GoodsReceiptLine[]

  @@unique([tenantId, number])
}

model GoodsReceiptLine {
  id          String       @id @default(cuid())
  tenantId    String
  receiptId   String
  receipt     GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderLineId String
  quantity    Int
  unitMinor   Int
}

/// فاتورة مورد مطابقة ثلاثياً مع أمر الشراء والاستلام
model SupplierBill {
  id             String             @id @default(cuid())
  tenantId       String
  number         Int
  supplierId     String
  orderId        String?
  supplierRef    String
  billDate       DateTime           @db.Date
  dueDate        DateTime           @db.Date
  subtotalMinor  Int
  taxMinor       Int
  totalMinor     Int
  paidMinor      Int                @default(0)
  /// OPEN | PARTIAL | PAID | CANCELLED
  status         String             @default("OPEN")
  /// MATCHED | PRICE_VARIANCE | DIRECT
  matchStatus    String             @default("MATCHED")
  varianceMinor  Int                @default(0)
  journalEntryId String?
  attachments    Json               @default("[]")
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  lines          SupplierBillLine[]

  @@unique([tenantId, number])
  @@unique([tenantId, supplierId, supplierRef])
}

model SupplierBillLine {
  id          String       @id @default(cuid())
  tenantId    String
  billId      String
  bill        SupplierBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  orderLineId String?
  accountId   String?
  description String
  quantity    Int
  unitMinor   Int
  taxBp       Int          @default(0)
}

model SupplierPayment {
  id             String   @id @default(cuid())
  tenantId       String
  number         Int
  supplierId     String
  billId         String?
  date           DateTime @db.Date
  amountMinor    Int
  /// CASH | BANK_TRANSFER | CHEQUE
  method         String
  bankAccountId  String?
  reference      String?
  journalEntryId String?
  createdById    String?
  createdAt      DateTime @default(now())

  @@unique([tenantId, number])
}

model StockCount {
  id             String           @id @default(cuid())
  tenantId       String
  number         Int
  warehouseId    String
  date           DateTime         @db.Date
  /// OPEN | POSTED
  status         String           @default("OPEN")
  notes          String?
  varianceMinor  Int              @default(0)
  journalEntryId String?
  createdById    String?
  createdAt      DateTime         @default(now())
  lines          StockCountLine[]

  @@unique([tenantId, number])
}

model StockCountLine {
  id         String     @id @default(cuid())
  tenantId   String
  countId    String
  count      StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  itemId     String
  systemQty  Int
  countedQty Int?
}

/// عملية بيع (متجر الزي والكتب أو المقصف)
model Sale {
  id             String     @id @default(cuid())
  tenantId       String
  number         Int
  /// STORE | CANTEEN
  kind           String
  date           DateTime   @default(now())
  warehouseId    String
  branchId       String?
  studentId      String?
  customerName   String?
  /// CASH | CARD | STUDENT_ACCOUNT | WALLET
  paymentMethod  String
  subtotalMinor  Int
  taxMinor       Int
  totalMinor     Int
  costMinor      Int        @default(0)
  invoiceId      String?
  journalEntryId String?
  /// COMPLETED | VOIDED
  status         String     @default("COMPLETED")
  cashierId      String?
  createdAt      DateTime   @default(now())
  lines          SaleLine[]

  @@unique([tenantId, number])
  @@index([tenantId, kind, date])
}

model SaleLine {
  id         String @id @default(cuid())
  tenantId   String
  saleId     String
  sale       Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemId     String
  name       String
  quantity   Int
  unitMinor  Int
  taxBp      Int    @default(0)
  taxMinor   Int    @default(0)
  totalMinor Int
  costMinor  Int    @default(0)
}

/// محفظة الطالب المدفوعة مسبقاً للمقصف (الرصيد لا يكون سالباً — مشغّل قاعدة البيانات)
model StudentWallet {
  id                String              @id @default(cuid())
  tenantId          String
  studentId         String
  balanceMinor      Int                 @default(0)
  dailyLimitMinor   Int?
  lowBalanceMinor   Int?
  notifyPurchases   Boolean             @default(true)
  /// فئات أصناف ممنوعة على الطالب (مثل المشروبات الغازية)
  blockedCategories Json                @default("[]")
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  transactions      WalletTransaction[]

  @@unique([tenantId, studentId])
}

model WalletTransaction {
  id                String        @id @default(cuid())
  tenantId          String
  walletId          String
  wallet            StudentWallet @relation(fields: [walletId], references: [id])
  /// TOPUP | FROM_CREDIT | PURCHASE | REFUND | ADJUSTMENT | WITHDRAWAL
  kind              String
  amountMinor       Int
  balanceAfterMinor Int
  method            String?
  saleId            String?
  journalEntryId    String?
  note              String?
  createdById       String?
  createdAt         DateTime      @default(now())

  @@index([tenantId, walletId, createdAt])
}

// ---------------------------------------------------------------------
// المرافق والصيانة
// ---------------------------------------------------------------------

model MaintenanceRequest {
  id                String    @id @default(cuid())
  tenantId          String
  number            Int
  title             String
  description       String?
  /// ELECTRICAL | PLUMBING | HVAC | CARPENTRY | IT | CLEANING | SAFETY | VEHICLE | OTHER
  category          String    @default("OTHER")
  /// LOW | MEDIUM | HIGH | URGENT
  priority          String    @default("MEDIUM")
  /// NEW | IN_PROGRESS | WAITING_PARTS | DONE | CANCELLED
  status            String    @default("NEW")
  branchId          String?
  roomId            String?
  location          String?
  assetId           String?
  busId             String?
  reportedById      String?
  assigneeId        String?
  dueDate           DateTime? @db.Date
  startedAt         DateTime?
  completedAt       DateTime?
  beforePhotos      Json      @default("[]")
  afterPhotos       Json      @default("[]")
  partsCostMinor    Int       @default(0)
  externalCostMinor Int       @default(0)
  vendorName        String?
  journalEntryId    String?
  scheduleId        String?
  resolution        String?
  position          Float     @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

/// صيانة وقائية دورية تولّد طلبات تلقائياً
model MaintenanceSchedule {
  id            String    @id @default(cuid())
  tenantId      String
  title         String
  description   String?
  category      String    @default("OTHER")
  branchId      String?
  roomId        String?
  assetId       String?
  busId         String?
  assigneeId    String?
  frequencyDays Int
  nextDue       DateTime  @db.Date
  isActive      Boolean   @default(true)
  lastRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// حجز القاعات والملاعب والمختبرات
model RoomBooking {
  id         String   @id @default(cuid())
  tenantId   String
  roomId     String
  title      String
  date       DateTime @db.Date
  startTime  String
  endTime    String
  /// CONFIRMED | CANCELLED
  status     String   @default("CONFIRMED")
  notes      String?
  bookedById String?
  createdAt  DateTime @default(now())

  @@index([tenantId, roomId, date])
}

// ---------------------------------------------------------------------
// المواصلات
// ---------------------------------------------------------------------

model Bus {
  id               String           @id @default(cuid())
  tenantId         String
  code             String
  plateNumber      String
  model            String?
  year             Int?
  capacity         Int
  branchId         String?
  driverId         String?
  supervisorId     String?
  assetId          String?
  insuranceExpiry  DateTime?        @db.Date
  licenseExpiry    DateTime?        @db.Date
  inspectionExpiry DateTime?        @db.Date
  /// ACTIVE | MAINTENANCE | RETIRED
  status           String           @default("ACTIVE")
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  routes           TransportRoute[]
  logs             BusLog[]

  @@unique([tenantId, code])
}

model TransportRoute {
  id             String                @id @default(cuid())
  tenantId       String
  code           String
  name           String
  busId          String?
  bus            Bus?                  @relation(fields: [busId], references: [id])
  branchId       String?
  /// رسوم العام الكاملة للخط (تُفوتر بنسبة المدة المتبقية عند التسكين حسب الإعدادات)
  annualFeeMinor Int                   @default(0)
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  stops          TransportStop[]
  assignments    TransportAssignment[]

  @@unique([tenantId, code])
}

model TransportStop {
  id            String         @id @default(cuid())
  tenantId      String
  routeId       String
  route         TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name          String
  order         Int
  lat           Float?
  lng           Float?
  morningTime   String?
  afternoonTime String?
}

model TransportAssignment {
  id          String         @id @default(cuid())
  tenantId    String
  studentId   String
  routeId     String
  route       TransportRoute @relation(fields: [routeId], references: [id])
  stopId      String?
  /// BOTH | MORNING | AFTERNOON
  direction   String         @default("BOTH")
  startDate   DateTime       @db.Date
  endDate     DateTime?      @db.Date
  /// ACTIVE | ENDED
  status      String         @default("ACTIVE")
  invoiceId   String?
  createdById String?
  createdAt   DateTime       @default(now())

  @@index([tenantId, studentId, status])
}

model BusLog {
  id             String   @id @default(cuid())
  tenantId       String
  busId          String
  bus            Bus      @relation(fields: [busId], references: [id])
  /// MAINTENANCE | FUEL | INSPECTION | INSURANCE | ACCIDENT
  kind           String
  date           DateTime @db.Date
  odometer       Int?
  costMinor      Int      @default(0)
  description    String
  journalEntryId String?
  createdById    String?
  createdAt      DateTime @default(now())
}

/// رحلة يومية (بدء المشرفة للرحلة وتحديث المحطة يرسل إشعار الاقتراب)
model BusTrip {
  id            String    @id @default(cuid())
  tenantId      String
  busId         String
  routeId       String
  date          DateTime  @db.Date
  /// MORNING | AFTERNOON
  shift         String
  /// STARTED | COMPLETED
  status        String    @default("STARTED")
  currentStopId String?
  boarded       Json      @default("[]")
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  createdById   String?

  @@unique([tenantId, routeId, date, shift])
}

// ---------------------------------------------------------------------
// المكتبة
// ---------------------------------------------------------------------

model LibraryBook {
  id           String               @id @default(cuid())
  tenantId     String
  isbn         String?
  title        String
  author       String?
  publisher    String?
  year         Int?
  category     String?
  language     String               @default("ar")
  callNumber   String?
  description  String?
  coverUrl     String?
  /// مورد رقمي (رابط أو ملف) بدل النسخ الورقية
  isDigital    Boolean              @default(false)
  digitalUrl   String?
  branchId     String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  deletedAt    DateTime?
  copies       LibraryCopy[]
  reservations LibraryReservation[]

  @@index([tenantId, isbn])
}

model LibraryCopy {
  id         String        @id @default(cuid())
  tenantId   String
  bookId     String
  book       LibraryBook   @relation(fields: [bookId], references: [id])
  barcode    String
  shelf      String?
  /// AVAILABLE | ON_LOAN | ON_HOLD | LOST | DAMAGED | WITHDRAWN
  status     String        @default("AVAILABLE")
  acquiredAt DateTime?     @db.Date
  priceMinor Int?
  lastSeenAt DateTime?
  createdAt  DateTime      @default(now())
  loans      LibraryLoan[]

  @@unique([tenantId, barcode])
}

model LibraryLoan {
  id            String      @id @default(cuid())
  tenantId      String
  copyId        String
  copy          LibraryCopy @relation(fields: [copyId], references: [id])
  studentId     String?
  userId        String?
  borrowerName  String
  loanedAt      DateTime    @default(now())
  dueDate       DateTime    @db.Date
  returnedAt    DateTime?
  renewals      Int         @default(0)
  fineMinor     Int         @default(0)
  /// NONE | INVOICED | WAIVED
  fineStatus    String      @default("NONE")
  fineInvoiceId String?
  issuedById    String?
  notes         String?

  @@index([tenantId, returnedAt])
}

model LibraryReservation {
  id         String      @id @default(cuid())
  tenantId   String
  bookId     String
  book       LibraryBook @relation(fields: [bookId], references: [id])
  studentId  String?
  userId     String?
  name       String
  /// WAITING | READY | FULFILLED | CANCELLED | EXPIRED
  status     String      @default("WAITING")
  copyId     String?
  readyUntil DateTime?   @db.Date
  createdAt  DateTime    @default(now())
}

/// جرد المكتبة بالمسح
model LibraryStockTake {
  id          String    @id @default(cuid())
  tenantId    String
  branchId    String?
  startedAt   DateTime  @default(now())
  closedAt    DateTime?
  scanned     Json      @default("[]")
  missing     Int?
  createdById String?
}

// ---------------------------------------------------------------------
// الأمن والسلامة والعيادة
// ---------------------------------------------------------------------

model Visitor {
  id           String    @id @default(cuid())
  tenantId     String
  number       Int
  fullName     String
  idLast4      String?
  idHash       String?
  phone        String?
  company      String?
  purpose      String
  hostName     String?
  hostUserId   String?
  branchId     String?
  /// رمز البطاقة/QR للدخول
  badgeCode    String
  expectedAt   DateTime?
  checkInAt    DateTime?
  checkOutAt   DateTime?
  vehiclePlate String?
  notes        String?
  createdById  String?
  createdAt    DateTime  @default(now())

  @@unique([tenantId, number])
  @@unique([tenantId, badgeCode])
  @@index([tenantId, checkInAt])
}

/// مفوَّض باستلام الطالب (غير ولي الأمر)
model AuthorizedPickup {
  id          String    @id @default(cuid())
  tenantId    String
  studentId   String
  name        String
  relation    String
  idLast4     String?
  idHash      String?
  phone       String?
  photoUrl    String?
  validUntil  DateTime? @db.Date
  isActive    Boolean   @default(true)
  createdById String?
  createdAt   DateTime  @default(now())
}

model StudentPickup {
  id                 String   @id @default(cuid())
  tenantId           String
  studentId          String
  guardianId         String?
  authorizedPickupId String?
  pickedByName       String
  relation           String
  /// ID_CHECK | PHOTO | CODE
  verification       String
  early              Boolean  @default(false)
  reason             String?
  at                 DateTime @default(now())
  recordedById       String?
  notes              String?

  @@index([tenantId, at])
}

model SafetyIncident {
  id                String    @id @default(cuid())
  tenantId          String
  number            Int
  /// INJURY | FIGHT | FIRE | PROPERTY | SECURITY | HEALTH | BUS | OTHER
  kind              String
  /// LOW | MEDIUM | HIGH | CRITICAL
  severity          String    @default("LOW")
  occurredAt        DateTime
  branchId          String?
  location          String
  description       String
  involved          Json      @default("[]")
  actionsTaken      String?
  /// OPEN | INVESTIGATING | CLOSED
  status            String    @default("OPEN")
  guardiansNotified Boolean   @default(false)
  attachments       Json      @default("[]")
  reportedById      String?
  closedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([tenantId, number])
}

model SafetyDrill {
  id              String    @id @default(cuid())
  tenantId        String
  /// FIRE | EVACUATION | EARTHQUAKE | LOCKDOWN | EQUIPMENT_CHECK
  kind            String
  branchId        String?
  scheduledAt     DateTime
  conductedAt     DateTime?
  durationSeconds Int?
  participants    Int?
  result          String?
  issues          String?
  /// SCHEDULED | DONE | MISSED
  status          String    @default("SCHEDULED")
  createdById     String?
  createdAt       DateTime  @default(now())
}

model EvacuationPlan {
  id             String    @id @default(cuid())
  tenantId       String
  branchId       String?
  title          String
  assemblyPoints String?
  description    String?
  fileUrl        String?
  reviewedAt     DateTime? @db.Date
  nextReview     DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// زيارة العيادة — الشكوى والملاحظات مشفّرة (بيانات صحية)
model ClinicVisit {
  id                String           @id @default(cuid())
  tenantId          String
  number            Int
  studentId         String?
  employeeId        String?
  patientName       String
  visitAt           DateTime         @default(now())
  complaintEnc      String
  notesEnc          String?
  temperatureTenths Int?
  /// RETURNED_TO_CLASS | RESTED | SENT_HOME | REFERRED | AMBULANCE
  outcome           String           @default("RETURNED_TO_CLASS")
  guardianNotified  Boolean          @default(false)
  nurseId           String?
  createdAt         DateTime         @default(now())
  dispenses         ClinicDispense[]

  @@unique([tenantId, number])
  @@index([tenantId, studentId])
}

model ClinicMedicine {
  id         String           @id @default(cuid())
  tenantId   String
  name       String
  form       String?
  unit       String           @default("قرص")
  quantity   Int              @default(0)
  minQty     Int              @default(0)
  expiryDate DateTime?        @db.Date
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  dispenses  ClinicDispense[]
}

model ClinicDispense {
  id         String         @id @default(cuid())
  tenantId   String
  visitId    String
  visit      ClinicVisit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  medicineId String
  medicine   ClinicMedicine @relation(fields: [medicineId], references: [id])
  quantity   Int
}
